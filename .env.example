APP_ENV=development
# Local light mode stays SQLite; Docker deployment uses PostgreSQL.
DATABASE_URL=sqlite:///./backend/data/aleria.db
# Opt-in tests only: set TEST_POSTGRES_URL in your shell to a disposable
# postgresql+psycopg:// test database. Never point it at live gameplay data.
FRONTEND_ORIGIN=http://127.0.0.1:5173
CHAT_PROVIDER=mock
CHAT_LLM_BASE_URL=
CHAT_LLM_API_KEY=
CHAT_LLM_MODEL=
CHAT_LLM_AUTH_MODE=bearer
CHAT_LLM_OUTPUT_MODE=structured_json
CHAT_LLM_TIMEOUT_SECONDS=30
CHAT_HISTORY_LIMIT=10
CHAT_PROMPT_VERSION=v3

# Independent memory embeddings; fake is deterministic and requires no network.
# Live mode is opt-in and falls back to fake when connection settings are incomplete.
EMBEDDING_PROVIDER=fake
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_AUTH_MODE=bearer
EMBEDDING_TIMEOUT_SECONDS=3
EMBEDDING_DIMENSIONS=32
COGNITION_ENRICHMENT_BATCH_SIZE=12
MEMORY_CHAT_LIMIT=6
MEMORY_CHAT_CHAR_BUDGET=1600
