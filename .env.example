APP_ENV=development
# Local light mode stays SQLite; Docker deployment uses PostgreSQL.
DATABASE_URL=sqlite:///./backend/data/aleria.db
# Opt-in tests only: set TEST_POSTGRES_URL in your shell to a disposable
# postgresql+psycopg:// test database. Never point it at live gameplay data.
FRONTEND_ORIGIN=http://127.0.0.1:5173
CHAT_PROVIDER=mock
CHAT_LLM_BASE_URL=
CHAT_LLM_API_KEY=
CHAT_LLM_MODEL=
CHAT_LLM_AUTH_MODE=bearer
CHAT_LLM_OUTPUT_MODE=structured_json
CHAT_LLM_TIMEOUT_SECONDS=30
CHAT_HISTORY_LIMIT=10
CHAT_PROMPT_VERSION=v3

# Independent memory embeddings; fake is deterministic and requires no network.
# Live mode is opt-in and falls back to fake when connection settings are incomplete.
EMBEDDING_PROVIDER=fake
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_AUTH_MODE=bearer
EMBEDDING_TIMEOUT_SECONDS=3
EMBEDDING_DIMENSIONS=32
COGNITION_ENRICHMENT_BATCH_SIZE=12
MEMORY_CHAT_LIMIT=6
MEMORY_CHAT_CHAR_BUDGET=1600

# Evidence-bound reflection uses independent opt-in provider settings.
REFLECTION_PROVIDER=fake
REFLECTION_BASE_URL=
REFLECTION_API_KEY=
REFLECTION_MODEL=
REFLECTION_AUTH_MODE=bearer
REFLECTION_TIMEOUT_SECONDS=3
REFLECTION_IMPORTANCE_THRESHOLD=2.0
REFLECTION_MIN_NEW_MEMORIES=3
REFLECTION_MEMORY_LIMIT=12
REFLECTION_CHAR_BUDGET=4000

# Native tool-calling planner. Leave blank to keep the deterministic fake planner;
# the world still advances when planning is unavailable (spec 3m section 13).
PLANNING_PROVIDER_BASE_URL=
PLANNING_PROVIDER_API_KEY=
PLANNING_PROVIDER_MODEL=
PLANNING_PROVIDER_AUTH_MODE=bearer
# Native tool calling with a 6-tool manifest is slow: measured 7.6-17s per call.
PLANNING_PROVIDER_TIMEOUT_SECONDS=20
