# Copy to .env.production on the deployment host. Never commit the real file.
APP_ENV=production
# Compose derives the PostgreSQL URL from these credentials.
# Replace the demo-only password before deployment. Use URL-safe credentials,
# or explicitly set DATABASE_URL with percent-encoded user/password components.
POSTGRES_DB=aleria
POSTGRES_USER=aleria
POSTGRES_PASSWORD=change-me-demo-only
FRONTEND_ORIGIN=http://localhost
HTTP_PORT=80

# Optional: use https://registry.npmmirror.com when npmjs is slow in China.
NPM_REGISTRY=https://registry.npmjs.org

# Safe default: the complete Demo works without any external model or API key.
CHAT_PROVIDER=mock
CHAT_LLM_BASE_URL=
CHAT_LLM_API_KEY=
CHAT_LLM_MODEL=
CHAT_LLM_AUTH_MODE=bearer
CHAT_LLM_OUTPUT_MODE=structured_json
CHAT_LLM_TIMEOUT_SECONDS=30
CHAT_HISTORY_LIMIT=10
CHAT_PROMPT_VERSION=v3

# Cognition projection runs synchronously after the tick commits; the budget is
# its upper bound, not a fixed cost. With the fake providers catch-up takes about
# 0.2s, so a high value costs nothing. With a live reflection provider the 5s
# default times out every reflection at 4.9s -- a single reflection measured 8-11s.
COGNITION_SOURCE_BATCH_SIZE=25
COGNITION_ATTENTION_BUDGET=12
COGNITION_POST_COMMIT_BUDGET_SECONDS=20

# Independent memory embeddings; explicitly set openai_compatible for live use.
# Supply URL/model and a bearer key, or use auth mode none on a trusted endpoint.
EMBEDDING_PROVIDER=fake
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_AUTH_MODE=bearer
EMBEDDING_TIMEOUT_SECONDS=3
EMBEDDING_DIMENSIONS=32
COGNITION_ENRICHMENT_BATCH_SIZE=12
MEMORY_CHAT_LIMIT=6
MEMORY_CHAT_CHAR_BUDGET=1600

# Reflection is optional; incomplete live settings fall back to fake.
REFLECTION_PROVIDER=fake
REFLECTION_BASE_URL=
REFLECTION_API_KEY=
REFLECTION_MODEL=
REFLECTION_AUTH_MODE=bearer
REFLECTION_TIMEOUT_SECONDS=3
REFLECTION_IMPORTANCE_THRESHOLD=2.0
REFLECTION_MIN_NEW_MEMORIES=3
REFLECTION_MEMORY_LIMIT=12
REFLECTION_CHAR_BUDGET=4000

# Native tool-calling planner -- the Stage 3m agent loop. Leave blank to keep the
# deterministic stand-in planner; the world still advances when planning is
# unavailable (Stage 3m spec section 13). Set base URL, model and a bearer key
# (or auth mode none on a trusted endpoint) to drive NPCs with a real model.
PLANNING_PROVIDER_BASE_URL=
PLANNING_PROVIDER_API_KEY=
PLANNING_PROVIDER_MODEL=
PLANNING_PROVIDER_AUTH_MODE=bearer
# Native tool calling with a 6-tool manifest is slow: measured 7.6-17s per call.
PLANNING_PROVIDER_TIMEOUT_SECONDS=30

# Switching any provider to openai_compatible: raise that provider's own
# *_TIMEOUT_SECONDS as well. The 3s reflection/embedding defaults only fit the
# fake providers. Incomplete live settings fall back to fake instead of failing
# to start, so a silent fallback is the symptom of a half-finished switch.
# One tick can then cost up to PLANNING_PROVIDER_TIMEOUT_SECONDS plus
# COGNITION_POST_COMMIT_BUDGET_SECONDS before /api/world/tick responds.
