# Copy to .env.production on the deployment host. Never commit the real file.
APP_ENV=production
# Compose derives the PostgreSQL URL from these credentials.
# Replace the demo-only password before deployment. Use URL-safe credentials,
# or explicitly set DATABASE_URL with percent-encoded user/password components.
POSTGRES_DB=aleria
POSTGRES_USER=aleria
POSTGRES_PASSWORD=change-me-demo-only
FRONTEND_ORIGIN=http://localhost
HTTP_PORT=80

# Optional: use https://registry.npmmirror.com when npmjs is slow in China.
NPM_REGISTRY=https://registry.npmjs.org

# Safe default: the complete Demo works without any external model or API key.
CHAT_PROVIDER=mock
CHAT_LLM_BASE_URL=
CHAT_LLM_API_KEY=
CHAT_LLM_MODEL=
CHAT_LLM_AUTH_MODE=bearer
CHAT_LLM_OUTPUT_MODE=structured_json
CHAT_LLM_TIMEOUT_SECONDS=30
CHAT_HISTORY_LIMIT=10
CHAT_PROMPT_VERSION=v3

# Independent memory embeddings; explicitly set openai_compatible for live use.
# Supply URL/model and a bearer key, or use auth mode none on a trusted endpoint.
EMBEDDING_PROVIDER=fake
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_AUTH_MODE=bearer
EMBEDDING_TIMEOUT_SECONDS=3
EMBEDDING_DIMENSIONS=32
COGNITION_ENRICHMENT_BATCH_SIZE=12
MEMORY_CHAT_LIMIT=6
MEMORY_CHAT_CHAR_BUDGET=1600

# Reflection is optional; incomplete live settings fall back to fake.
REFLECTION_PROVIDER=fake
REFLECTION_BASE_URL=
REFLECTION_API_KEY=
REFLECTION_MODEL=
REFLECTION_AUTH_MODE=bearer
REFLECTION_TIMEOUT_SECONDS=3
REFLECTION_IMPORTANCE_THRESHOLD=2.0
REFLECTION_MIN_NEW_MEMORIES=3
REFLECTION_MEMORY_LIMIT=12
REFLECTION_CHAR_BUDGET=4000
